{
  "entities": {
    "tickets": {
      "title": "Tickets",
      "description": "Event tickets and their check-in status",
      "type": "object",
      "properties": {
        "hash": { "type": "string", "description": "Unique identifier for the ticket QR code" },
        "name": { "type": "string", "description": "Customer name" },
        "whatsapp": { "type": "string", "description": "Customer phone" },
        "type": { "type": "string", "description": "Type of ticket (individual/casadinho)" },
        "qty": { "type": "integer", "description": "Quantity of items" },
        "status": { "type": "string", "enum": ["Ativa", "Entregue", "Cancelada"], "description": "Registration status" },
        "checkedIn": { "type": "boolean", "description": "Whether the customer has entered the event" },
        "checkedInAt": { "type": "string", "format": "date-time", "description": "Timestamp of check-in" },
        "imageUrl": { "type": "string", "description": "Link to the personalized ticket image" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hash", "name", "type", "qty", "status", "createdAt"]
    }
  },
  "firestore": {
    "tickets": {
      "schema": "tickets",
      "description": "Collection of event tickets"
    }
  }
}
